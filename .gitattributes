# Normalize line endings for deterministic, cross-platform builds.
* text=auto eol=lf

# Windows-specific scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.snk binary
*.pfx binary
*.nupkg binary
*.snupkg binary
