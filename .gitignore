# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
artifacts/
*.user

# NuGet
*.nupkg
*.snupkg
# Local NuGet API key — NEVER commit. Publishing uses Trusted Publishing
# (GitHub OIDC → short-lived key via NuGet/login), so no long-lived key should
# exist anywhere — revoke any old one on nuget.org. These patterns stay as a
# belt-and-braces guard for any stray local key file.
nuget.key
nuget.key.*
*.nuget.key

# IDE
.vs/
.idea/
*.suo

# Test / coverage
[Tt]est[Rr]esults/
coverage*.json
coverage*.xml
*.trx

# OS
.DS_Store
Thumbs.db
